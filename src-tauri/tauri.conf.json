{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FRE LAUNCH",
  "version": "0.5.0",
  "identifier": "app.frelaunch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FRE LAUNCH",
        "width": 1200,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "backgroundColor": "#0d101a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
